# GEMINI_API_KEY: Required for Gemini AI API calls if AI utilities are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Mandatory Primary Backend Platform for Production)
# Copy these values from your Supabase Project Dashboard -> Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# SERVER SESSION SECRET (Used for signed HTTP-only session cookies)
SESSION_SECRET="replace-with-a-long-random-secret-string"
