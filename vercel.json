{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|uploads/|assets/|media/|pwa-|apple-touch-icon|manifest\\.webmanifest|sw\\.js|workbox-|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
